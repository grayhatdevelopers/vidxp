{
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "lib": ["ESNext", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "types": [
      "@adobe/cc-ext-uxp-types",
      "@adobe/premierepro",
      "@types/node",
      "vitest/globals"
    ]
  },
  "include": [
    "index.tsx",
    "src/**/*.ts",
    "src/**/*.tsx",
    "tests/**/*.ts",
    "uxp.config.ts",
    "vite.config.ts"
  ],
  "exclude": ["dist", "node_modules"]
}
