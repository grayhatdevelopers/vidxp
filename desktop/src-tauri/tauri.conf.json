{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VidXP",
  "version": "0.4.0-b.3",
  "identifier": "dev.grayhat.vidxp",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost",
      "devCsp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost ws:"
    },
    "windows": [
      {
        "label": "main",
        "title": "VidXP",
        "width": 920,
        "height": 760,
        "minWidth": 680,
        "minHeight": 600,
        "visible": false,
        "resizable": true,
        "decorations": true,
        "shadow": true,
        "transparent": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "../THIRD_PARTY_NOTICES.txt",
      "../../LICENSE"
    ],
    "externalBin": [
      "binaries/uv"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "nsis-hooks.nsh"
      }
    },
    "macOS": {
      "minimumSystemVersion": "13.0",
      "entitlements": "entitlements.plist"
    }
  }
}
